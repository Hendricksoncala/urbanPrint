generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER")
  orders    Order[]
  reviewedPayments Payment[] @relation("PaymentReviewer")
  paymentEvents PaymentEvent[] @relation("PaymentActor")
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  price       Int
  category    String
  image       String
  stock       Int      @default(10)
  variants    InventoryVariant[]
  createdAt   DateTime @default(now())
}

model InventoryVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(10)
  @@unique([productId, color, size])
}

model Order {
  id        String   @id @default(cuid())
  number    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("RECIBIDO")
  total     Int
  items     String
  address   String
  email     String
  payment   String
  paymentStatus String @default("PENDING")
  paymentAmountInCents Int?
  paymentReference String? @unique
  paymentTransactionId String? @unique
  paymentProofUrl String?
  designAssets DesignAsset[]
  paymentEvents PaymentEvent[]
  paymentProofs PaymentProof[]
  manualPayment Payment?
  stockReserved Boolean @default(true)
  createdAt DateTime @default(now())
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type            String   @default("SYSTEM")
  actorId         String?
  actor           User?    @relation("PaymentActor", fields: [actorId], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime @default(now())
  providerEventKey String? @unique
  eventType       String?
  transactionId   String?
  reference       String?
  status          String?
  checksum        String?
  eventTimestamp  String?
  payload         String?
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receivedAt      DateTime @default(now())
  @@index([paymentId, createdAt])
}

enum PaymentStatus {
  PENDING_PROOF
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         String
  expectedAmount Int
  status         PaymentStatus @default(PENDING_PROOF)
  proofUrl       String?
  payerName      String?
  bankReference  String?       @unique
  paidAt         DateTime?
  declaredAmount Int?
  reviewedById   String?
  reviewedBy     User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectReason   String?
  proofDueAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  events         PaymentEvent[]
  @@index([status, proofDueAt])
}

model PaymentUploadAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  orderId   String
  createdAt DateTime @default(now())
  @@index([ipHash, createdAt])
  @@index([orderId, createdAt])
}

model PaymentProof {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  url       String   @unique
  mime      String
  createdAt DateTime @default(now())
}

model DesignAsset {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cartItemId     String
  originalUrl    String
  frontRenderUrl String?
  backRenderUrl  String?
  configuration  String
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Quote {
  id        String   @id @default(cuid())
  name      String
  company   String
  city      String
  quantity  Int
  email     String
  message   String
  createdAt DateTime @default(now())
}
